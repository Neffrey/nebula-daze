# This environment variable is used in Production and Preview environments to deploy your Convex project
# This variable is not needed in development.
# You can create a Production or Preview deploy key at https://dashboard.convex.dev/project/settings#production-deploy-keys
CONVEX_DEPLOY_KEY=

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Google OAuth2.0 Client ID and Secret. Create one at
# https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Google Places API (New). Enable "Places API (New)" and create a key at
# https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_PLACES_API_KEY=

# UploadThing token. Create one at https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=
